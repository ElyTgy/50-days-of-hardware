# Copy to .env.local and fill in from your Supabase project.
# Dashboard → Connect (or Project Settings → API / API Keys).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The client key: labeled "anon public" or "publishable". Either name works.
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Optional: your Google account email. When set, only this signed-in account
# sees edit controls. (The database enforces this regardless — see schema.sql.)
VITE_OWNER_EMAIL=you@gmail.com
